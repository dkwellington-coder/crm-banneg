generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  SELLER
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum LeadStatus {
  NEW
  AI_QUALIFYING
  QUALIFIED
  MEETING_BOOKED
  HANDED_OFF
  NURTURING
  DISQUALIFIED
  WON
  LOST
}

enum Channel {
  WHATSAPP
  EMAIL
  NOTE
}

enum Direction {
  IN
  OUT
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
  // Test mode: recorded but not really sent
  SIMULATED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(SELLER)
  phone        String?
  calendarId   String?
  createdAt    DateTime  @default(now())
  leads        Lead[]
  tasks        Task[]
  meetings     Meeting[]
  sessions     Session[]
  goals        Goal[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Pipeline {
  id             String   @id @default(cuid())
  name           String
  position       Int      @default(0)
  // The funnel new leads land in when nothing else is said
  isDefault      Boolean  @default(false)
  // Short name forms and landing pages use to drop leads here ("funil": "sindicatos")
  slug           String?  @unique
  // What the AI SDR is after in this funnel; empty = the franchise sales script
  aiGoal         String?
  // Data the AI collects here; empty = the questions in Ajustes
  aiQuestions    String[] @default([])
  // Where the AI sends a lead when this funnel lacks the stage (old leads go on to Vendas de Franquias)
  nextPipelineId String?
  createdAt      DateTime @default(now())
  stages         Stage[]
  leads          Lead[]
}

model Stage {
  id         String           @id @default(cuid())
  pipelineId String
  pipeline   Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  // Stable key the AI uses (novo, qualificando, ...); null for stages the team creates
  key        String?
  name       String
  position   Int
  kind       StageKind        @default(OPEN)
  color      String           @default("#64748b")
  leads      Lead[]
  rules      AutomationRule[]

  @@unique([pipelineId, key])
}

// "When the lead enters this stage (or stops answering), after X time, do Y"
model AutomationRule {
  id              String   @id @default(cuid())
  stageId         String
  stage           Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  // enter = entrou na etapa; idle = ficou sem responder
  trigger         String   @default("enter")
  delayMinutes    Int      @default(0)
  // whatsapp | email | task | move | ai_on | ai_off
  action          String
  config          Json     @default("{}")
  // false = only runs while the lead is still in this stage
  runAfterLeaving Boolean  @default(false)
  active          Boolean  @default(true)
  position        Int      @default(0)
  createdAt       DateTime @default(now())
}

model Goal {
  id     String  @id @default(cuid())
  // null = meta da equipe
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // atendimentos | reunioes | vendas | receita
  metric String
  // YYYY-MM
  period String
  target Int

  @@unique([userId, metric, period])
}

model SdrAgent {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  persona   String
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Lead {
  id              String        @id @default(cuid())
  name            String?
  phone           String?       @unique
  email           String?
  city            String?
  state           String?
  source          String        @default("manual")
  campaign        String?
  externalId      String?
  pipelineId      String
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId         String
  stage           Stage         @relation(fields: [stageId], references: [id])
  // Deal value in reais, for the sales goal
  value           Int?
  wonAt           DateTime?
  status          LeadStatus    @default(NEW)
  ownerId         String?
  owner           User?         @relation(fields: [ownerId], references: [id])
  sdrId           String?
  sdr             SdrAgent?     @relation(fields: [sdrId], references: [id])
  aiPaused        Boolean       @default(false)
  emailOptOut     Boolean       @default(false)
  // Lead tapped "Parar mensagens" (or wrote PARAR/SAIR): no more automatic WhatsApp
  whatsappOptOut  Boolean       @default(false)
  score           Int?
  temperature     String?
  // Answers the SDR collected (capital, region, timeline, decision maker...)
  qualification   Json          @default("{}")
  aiSummary       String?
  lostReason      String?
  lastInboundAt   DateTime?
  lastContactAt   DateTime?
  // When someone on the team first opened the lead; null = new lead nobody has looked at yet
  seenAt          DateTime?
  // Someone answered, moved the lead or marked the alert as seen: what came before stops alerting
  alertsClearedAt DateTime?
  stageEnteredAt  DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        Message[]
  events          LeadEvent[]
  tasks           Task[]
  meetings        Meeting[]
  cofDeliveries   CofDelivery[]
  jobs            Job[]

  @@index([stageId])
  @@index([status])
}

model Message {
  id         String        @id @default(cuid())
  leadId     String
  lead       Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel    Channel
  direction  Direction
  body       String
  author     String
  status     MessageStatus @default(QUEUED)
  externalId String?       @unique
  template   String?
  error      String?
  // Meta's error code, so failures that mean "this number can't get WhatsApp" can be counted
  errorCode  Int?
  // "audio" for a voice note or audio file: the body holds its transcript and the bytes live in MessageMedia
  mediaKind  String?
  mediaType  String?
  media      MessageMedia?
  createdAt  DateTime      @default(now())

  @@index([leadId, createdAt])
}

// The file of an audio message, kept apart so loading a conversation never loads the audio
model MessageMedia {
  messageId String  @id
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
}

// Timeline: everything that happened to a lead, including each AI decision.
model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  actor     String
  summary   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Task {
  id        String    @id @default(cuid())
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  title     String
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}

model Meeting {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  calendarEventId String?
  meetLink        String?
  status          String   @default("scheduled")
  createdAt       DateTime @default(now())
}

// Durable queue: every automation, follow-up, email and AI turn runs through here, with retries and a log.
model Job {
  id          String    @id @default(cuid())
  type        String
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  payload     Json      @default("{}")
  runAt       DateTime  @default(now())
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  result      String?
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  subject     String
  body        String
  // Sequence step: days after the lead enters the sequence (null = manual only)
  sequenceDay Int?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model WhatsAppTemplate {
  id        String  @id @default(cuid())
  name      String  @unique
  language  String  @default("pt_BR")
  body      String
  purpose   String  @default("reengagement")
  // true = approved by Meta, so the CRM may send it
  active    Boolean @default(true)
  // MARKETING | UTILITY, as submitted to Meta
  category  String  @default("MARKETING")
  // Quick reply button labels, in order
  buttons   Json    @default("[]")
  // Public video, PDF or image shown above the text (a video header goes with the message itself)
  headerUrl String?
  // draft (only in the CRM) | PENDING | APPROVED | REJECTED | PAUSED | DISABLED, as Meta reports it
  status    String  @default("APPROVED")
  // Meta's reason when it rejects the template
  metaNote  String?
}

model Macro {
  id    String @id @default(cuid())
  title String
  body  String
}

// Business knowledge the SDR may use, and nothing else.
model KnowledgeItem {
  id        String   @id @default(cuid())
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value Json
}

// What Meta charged per campaign per day, read from the ad accounts, to put a cost on each lead and sale
model AdSpend {
  // date:campaignId
  id           String   @id
  date         DateTime @db.Date
  accountId    String
  campaignId   String
  campaignName String
  // Reais
  spend        Float    @default(0)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  // Leads Meta counted for the campaign, to compare with what reached the CRM
  metaLeads    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([date])
}

// A document of the franchise offer (COF, balance sheets, contract), uploaded in Ajustes. Removing or
// replacing one keeps the old file, so every COF already sent still opens exactly what went.
model FranchiseDocument {
  id         String   @id @default(cuid())
  name       String
  mimeType   String
  size       Int      @default(0)
  // Set when the upload finished; until then the file is still arriving in parts
  sha256     String?
  data       Bytes
  active     Boolean  @default(false)
  uploadedBy String
  createdAt  DateTime @default(now())
}

// Each COF e-mailed to a lead: the e-mail exactly as it went, and the proof the lead got it.
model CofDelivery {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // In the lead's confirmation link
  token        String    @unique
  to           String
  subject      String
  body         String
  // [{ id, name, size, sha256 }] of the documents sent
  documents    Json
  attached     Boolean   @default(true)
  messageId    String?
  // What the mail server answered ("250 OK ...")
  smtpResponse String?
  // The .eml, byte for byte as it went
  raw          Bytes?
  sentBy       String
  sentAt       DateTime  @default(now())
  openedAt     DateTime?
  downloadedAt DateTime?
  confirmedAt  DateTime?
  confirmIp    String?
  confirmAgent String?

  @@index([leadId, sentAt])
}
