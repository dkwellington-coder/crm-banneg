# Banco de dados (Postgres: Supabase, Neon, ou o Postgres da TurboCloud)
DATABASE_URL="postgresql://usuario:senha@host:5432/crm"

# IA (SDRs Duda e Alice) — chave em console.anthropic.com
ANTHROPIC_API_KEY=
# SDR_MODEL=claude-opus-5-5

# WhatsApp oficial (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=uma-frase-secreta-qualquer
WHATSAPP_APP_SECRET=
# ID da conta do WhatsApp Business (para importar os modelos aprovados)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# E-mails automáticos (Gmail: smtp.gmail.com, porta 465, senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Expansão Banneg <expansao@banneg.com.br>"

# Google Agenda (opcional: sem isso a reunião fica só no CRM)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Segredos das rotas públicas
LEADS_API_TOKEN=
CRON_SECRET=

# Primeiro acesso (usado só pelo npm run db:seed)
SEED_OWNER_EMAIL=wellington@banneg.com.br
SEED_OWNER_PASSWORD=
